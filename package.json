  "lint-staged": {
    "**/*.md": "markdownlint-cli2",
    "content/**/*.md": "node --import tsx scripts/check-frontmatter.ts"
  },
  "name": "sharhoroots",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undead404/sharhoroots.git"
  },
  "scripts": {
    "build": "./quartz/bootstrap-cli.mjs build",
    "build:plugins": "npm --prefix plugins/places-map run build",
    "check": "npm run lint:frontmatter && npm test && tsc --noEmit && npx prettier . --check",
    "docs": "CHOKIDAR_USEPOLLING=1 ./quartz/bootstrap-cli.mjs build --serve",
    "format": "npx prettier . --write",
    "lint:frontmatter": "node --import tsx scripts/check-frontmatter.ts",
    "lint:markdown": "markdownlint-cli2 \"AGENTS.md\" \".agents/**/*.md\" \".opencode/**/*.md\" \"content/**/*.md\" \"sources/**/*.md\" \"tasks/**/*.md\"",
    "prepare": "husky && npm run build:plugins",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "quartz": "./quartz/bootstrap-cli.mjs",
    "test": "tsx --test"
  },
  "type": "module",
  "version": "5.0.0"
