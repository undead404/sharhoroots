{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "openai/gpt-6-luna",
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git rev-parse *": "allow",
      "npm run check": "allow",
      "npm test": "allow",
      "git push *": "deny"
    }
  }
}
